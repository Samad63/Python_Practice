names = ["Samad", "Arman", "Zeba"]
marks = [82, 67, 91]

for i, name in enumerate(names):
    print(i, name)

for name, m in zip(names, marks):
    print(f"{name}: {m}")

squares = [x * x for x in range(1, 6)]
evens = [x for x in squares if x % 2 == 0]
print(squares, evens)