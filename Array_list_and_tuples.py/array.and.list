''' Looping tools
1. enumerate(list)- use it when you need position as well as the item. 
2. zip(a, b)- use it to pair up items from severel lists at once
3. Comprehension-[experssion for x in sequence if condition]'''



names = ["Samad", "Arman", "Zeba"]
marks = [82, 67, 91]

for i, name in enumerate(names):
    print(i, name)

for name, m in zip(names, marks):
    print(f"{name}: {m}")


squares = [x * x for x in range(1, 6)]
evens = [x for x in squares if x % 2 == 0]
print(squares, evens) 